{
  "name": "@weblabllc/book-kit",
  "version": "0.6.0",
  "type": "module",
  "description": "Framework-free EPUB/PDF/FB2 toolkit: manifest parsing, chunked resources, FB2 to EPUB, buyer watermarking with cyrillic transliteration",
  "keywords": [
    "epub",
    "fb2",
    "pdf",
    "ebook",
    "watermark",
    "reader",
    "drm",
    "typescript"
  ],
  "license": "MIT",
  "author": "WebLab LLC <hello@weblab.llc>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weblabllc/book-kit.git"
  },
  "homepage": "https://github.com/weblabllc/book-kit#readme",
  "bugs": {
    "url": "https://github.com/weblabllc/book-kit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "epubcheck": "node scripts/epubcheck.mjs"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.7",
    "adm-zip": "^0.5.16",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
