{
  "name": "@risklight/ebook-kit",
  "version": "0.4.0",
  "type": "module",
  "description": "Framework-free EPUB/PDF/FB2 toolkit: manifest parsing, chunked resources, FB2 to EPUB, buyer watermarking with cyrillic transliteration",
  "keywords": [
    "epub",
    "fb2",
    "pdf",
    "ebook",
    "watermark",
    "reader",
    "drm",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiskLightS/ebook-kit.git"
  },
  "homepage": "https://github.com/RiskLightS/ebook-kit",
  "bugs": {
    "url": "https://github.com/RiskLightS/ebook-kit/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
